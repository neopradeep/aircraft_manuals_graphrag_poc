# Copy to .env (git-ignored) and fill in. Never commit real keys.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Option A: OpenAI (default) ---
OPENAI_API_KEY=
# LLM_CHAT_MODEL=gpt-4o-mini
# LLM_EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536

# --- Option B: Fireworks (OpenAI-compatible). Uncomment and verify model names in the Fireworks model library ---
# LLM_BASE_URL=https://api.fireworks.ai/inference/v1
# LLM_API_KEY=
# LLM_CHAT_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
# LLM_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
# EMBED_DIM=768
